# Copy to .env.local. Everything is optional for local development.

# Public URL of the site (used for share links, OG images, auth callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database: defaults to a local SQLite file (.data/posy.db). In production use Turso / libSQL:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Auth (required in production): openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Optional social sign-in
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Image uploads in production (Vercel Blob). Locally, uploads go to public/uploads.
# BLOB_READ_WRITE_TOKEN=

# Optional: raises the GitHub API limit for repo tiles
# GITHUB_TOKEN=

# Who can sign up: first-user (default: the first account owns the instance), open, closed
# POSY_SIGNUP=first-user


# Where the SQLite file and uploads live (dev: ~/.posy, production: .data, Docker: /data)
# POSY_DATA_DIR=.data
