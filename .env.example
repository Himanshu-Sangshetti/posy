# Copy to .env.local. Everything is optional for local development.
# In production Posy refuses to start if a required value is missing (it tells you which).
# Full guide: docs/self-hosting.md

# ── Required in production ────────────────────────────────────────────────────

# Public URL of the site (share links, OG images, auth callbacks). Set before `npm run build`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The same URL, used by Better Auth. Must match NEXT_PUBLIC_SITE_URL's scheme and host.
# BETTER_AUTH_URL=http://localhost:3000
# Session signing secret, 32+ characters: openssl rand -base64 32
# Never use the placeholder from docker-compose.yml (change-me-to-a-long-random-string).
# BETTER_AUTH_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────

# Defaults to a local SQLite file in POSY_DATA_DIR. On Vercel / serverless use Turso (libSQL):
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=            # required for a remote DATABASE_URL: turso db tokens create <db>

# ── Instance ──────────────────────────────────────────────────────────────────

# Who can sign up: first-user (default: the first account owns the instance), open, closed
# POSY_SIGNUP=first-user
# Where the SQLite file and uploads live (dev: ~/.posy, production: .data, Docker: /data)
# POSY_DATA_DIR=.data

# ── Uploads ───────────────────────────────────────────────────────────────────

# Image uploads in production on Vercel (Vercel Blob). Locally, uploads go to the data dir.
# BLOB_READ_WRITE_TOKEN=

# ── Optional sign-in and integrations ─────────────────────────────────────────

# Social sign-in (set both of a pair)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Raises the GitHub API limit for repo tiles
# GITHUB_TOKEN=

# ── Anonymous usage stats (production only) ───────────────────────────────────

# On by default in production, off in development, CI and tests. What is sent: docs/telemetry.md
# Turn off with either of these:
# POSY_TELEMETRY=0
# DO_NOT_TRACK=1
# Advanced (forks): your own PostHog project
# POSY_TELEMETRY_KEY=
# POSY_TELEMETRY_HOST=https://us.i.posthog.com

# ── Scripts and tests (not read by the server) ────────────────────────────────

# For `npm run posy` and agents: your instance and an API key from Settings
# POSY_URL=http://localhost:3000
# POSY_API_KEY=posy_...
# Set by the e2e suite only: a throwaway database, relaxed boot checks, no telemetry
# POSY_E2E=1
