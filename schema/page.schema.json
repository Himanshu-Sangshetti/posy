            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable unique id, e.g. \"t-abc123\""
              },
              "size": {
                "default": "s",
                "description": "s = 1x1, w = 2x1, t = 1x2, l = 2x2",
                "type": "string",
                "enum": [
                  "s",
                  "w",
                  "t",
                  "l"
                ]
              },
              "color": {
                "default": "auto",
                "description": "Tile background. \"auto\" is the plain card colour; pick a tint to colour one tile",
                "type": "string",
                "enum": [
                  "auto",
                  "surface",
                  "accent",
                  "peach",
                  "butter",
                  "mint",
                  "sky",
                  "lilac",
                  "rose"
                ]
              },
              "pos": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1200,
                    "description": "Left edge, 0–1200"
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Top edge, 0 and up"
                  },
                  "w": {
                    "type": "number",
                    "minimum": 24,
                    "maximum": 1200,
                    "description": "Width, up to 1200"
                  },
                  "h": {
                    "type": "number",
                    "minimum": 24,
                    "description": "Height"
                  },
                  "r": {
                    "default": 0,
                    "description": "Rotation in degrees, -15 to 15",
                    "type": "number",
                    "minimum": -15,
                    "maximum": 15
                  },
                  "z": {
                    "default": 0,
                    "description": "Layer: higher sits on top",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "description": "Canvas layout only: where the tile sits. Tiles without it are placed automatically, flowing like the grid"
              },
              "type": {
                "type": "string",
                "const": "link"
              },
              "url": {
