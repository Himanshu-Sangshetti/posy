{
  "title": "Posy page",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bio": {
          "default": "",
          "type": "string"
        },
        "avatar": {
          "description": "Image URL or /path in public/",
          "type": "string"
        },
        "location": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "theme": {
      "default": {
        "preset": "cream",
        "font": "soft",
        "radius": "round",
        "layout": "split",
        "motion": true
      },
      "type": "object",
      "properties": {
        "preset": {
          "default": "cream",
          "type": "string",
          "enum": [
            "cream",
            "lavender",
            "mint",
            "sky",
            "peach",
            "paper",
            "midnight",
            "mocha"
          ]
        },
        "accent": {
          "description": "Override the theme accent, e.g. \"#e8a87c\"",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "font": {
          "default": "soft",
          "type": "string",
          "enum": [
            "soft",
            "editorial",
            "rounded",
            "mono"
          ]
        },
        "radius": {
          "default": "round",
          "type": "string",
          "enum": [
            "sharp",
            "soft",
            "round"
          ]
        },
        "layout": {
          "default": "split",
          "description": "split = profile beside the grid on desktop; stack = centred",
          "type": "string",
          "enum": [
            "split",
            "stack"
          ]
        },
        "motion": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "seo": {
      "default": {},
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "url": {
          "description": "Public URL of the page, used for share links and the QR code",
          "type": "string"
        }
      }
    },
    "tiles": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable unique id, e.g. \"t-abc123\""
              },
              "size": {
                "default": "s",
                "description": "s = 1x1, w = 2x1, t = 1x2, l = 2x2",
                "type": "string",
                "enum": [
                  "s",
                  "w",
                  "t",
                  "l"
                ]
              },
              "color": {
                "default": "auto",
                "description": "Tile background. \"auto\" picks a pastel from the theme",
                "type": "string",
                "enum": [
                  "auto",
                  "surface",
                  "accent",
                  "peach",
                  "butter",
                  "mint",
                  "sky",
                  "lilac",
                  "rose"
                ]
              },
              "type": {
                "type": "string",
                "const": "link"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "Absolute URL (https://...) or a path inside /public"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "image": {
                "description": "Preview image shown on wide/large tiles",
                "type": "string"
              }
            },
            "required": [
              "id",
              "type",
              "url"
            ],
            "description": "Any link, shown with its favicon and title"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable unique id, e.g. \"t-abc123\""
              },
              "size": {
                "default": "s",
                "description": "s = 1x1, w = 2x1, t = 1x2, l = 2x2",
                "type": "string",
                "enum": [
                  "s",
                  "w",
                  "t",
                  "l"
                ]
              },
              "color": {
                "default": "auto",
                "description": "Tile background. \"auto\" picks a pastel from the theme",
                "type": "string",
                "enum": [
                  "auto",
                  "surface",
                  "accent",
                  "peach",
                  "butter",
                  "mint",
                  "sky",
                  "lilac",
                  "rose"
                ]
              },
              "type": {
                "type": "string",
                "const": "social"
              },
              "platform": {
                "type": "string",
                "enum": [
                  "x",
                  "instagram",
                  "github",
                  "linkedin",
                  "youtube",
                  "tiktok",
                  "threads",
                  "bluesky",
                  "mastodon",
                  "dribbble",
                  "behance",
                  "spotify",
                  "twitch",
                  "discord",
                  "substack",
                  "medium",
                  "reddit",
                  "pinterest",
                  "producthunt",
                  "peerlist",
                  "devto",
                  "hashnode",
                  "itch",
                  "kofi",
                  "buymeacoffee",
                  "patreon",
                  "soundcloud",
                  "facebook",
                  "telegram",
                  "email"
                ]
              },
              "handle": {
                "type": "string",
                "minLength": 1,
                "description": "Username without @"
              },
              "url": {
                "description": "Override the profile URL",
                "type": "string"
              }
            },
            "required": [
              "id",
              "type",
              "platform",
              "handle"
            ],
            "description": "A social profile with the platform icon"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable unique id, e.g. \"t-abc123\""
              },
              "size": {
                "default": "s",
                "description": "s = 1x1, w = 2x1, t = 1x2, l = 2x2",
                "type": "string",
                "enum": [
                  "s",
                  "w",
                  "t",
                  "l"
                ]
              },
              "color": {
                "default": "auto",
                "description": "Tile background. \"auto\" picks a pastel from the theme",
                "type": "string",
                "enum": [
                  "auto",
                  "surface",
                  "accent",
                  "peach",
                  "butter",
                  "mint",
                  "sky",
                  "lilac",
                  "rose"
                ]
              },
              "type": {
                "type": "string",
                "const": "text"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "Short note. **bold** and [links](https://...) are supported"
              }
            },
            "required": [
              "id",
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable unique id, e.g. \"t-abc123\""
              },
              "size": {
                "default": "s",
                "description": "s = 1x1, w = 2x1, t = 1x2, l = 2x2",
                "type": "string",
                "enum": [
                  "s",
                  "w",
                  "t",
                  "l"
                ]
              },
              "color": {
                "default": "auto",
                "description": "Tile background. \"auto\" picks a pastel from the theme",
                "type": "string",
                "enum": [
                  "auto",
                  "surface",
                  "accent",
                  "peach",
                  "butter",
                  "mint",
                  "sky",
                  "lilac",
                  "rose"
                ]
              },
              "type": {
                "type": "string",
                "const": "heading"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "type",
              "text"
            ],
            "description": "Section title; always spans the full row"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable unique id, e.g. \"t-abc123\""
              },
              "size": {
                "default": "s",
                "description": "s = 1x1, w = 2x1, t = 1x2, l = 2x2",
                "type": "string",
                "enum": [
                  "s",
                  "w",
                  "t",
                  "l"
                ]
              },
              "color": {
                "default": "auto",
                "description": "Tile background. \"auto\" picks a pastel from the theme",
                "type": "string",
                "enum": [
                  "auto",
                  "surface",
                  "accent",
                  "peach",
                  "butter",
                  "mint",
                  "sky",
                  "lilac",
                  "rose"
                ]
              },
              "type": {
                "type": "string",
                "const": "image"
              },
              "src": {
                "type": "string",
                "minLength": 1,
                "description": "Absolute URL (https://...) or a path inside /public"
              },
              "alt": {
                "default": "",
                "type": "string"
              },
              "url": {
                "description": "Optional link when the image is clicked",
                "type": "string"
              },
              "caption": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "type",
              "src"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable unique id, e.g. \"t-abc123\""
              },
              "size": {
                "default": "s",
                "description": "s = 1x1, w = 2x1, t = 1x2, l = 2x2",
                "type": "string",
                "enum": [
                  "s",
                  "w",
                  "t",
                  "l"
                ]
              },
              "color": {
                "default": "auto",
                "description": "Tile background. \"auto\" picks a pastel from the theme",
                "type": "string",
                "enum": [
                  "auto",
                  "surface",
                  "accent",
                  "peach",
                  "butter",
                  "mint",
                  "sky",
                  "lilac",
                  "rose"
                ]
              },
              "type": {
                "type": "string",
                "const": "video"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "YouTube URL"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "type",
              "url"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable unique id, e.g. \"t-abc123\""
              },
              "size": {
                "default": "s",
                "description": "s = 1x1, w = 2x1, t = 1x2, l = 2x2",
                "type": "string",
                "enum": [
                  "s",
                  "w",
                  "t",
                  "l"
                ]
              },
              "color": {
                "default": "auto",
                "description": "Tile background. \"auto\" picks a pastel from the theme",
                "type": "string",
                "enum": [
                  "auto",
                  "surface",
                  "accent",
                  "peach",
                  "butter",
                  "mint",
                  "sky",
                  "lilac",
                  "rose"
                ]
              },
              "type": {
                "type": "string",
                "const": "music"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "Spotify track, album, playlist or artist URL"
              }
            },
            "required": [
              "id",
              "type",
              "url"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable unique id, e.g. \"t-abc123\""
              },
              "size": {
                "default": "s",
                "description": "s = 1x1, w = 2x1, t = 1x2, l = 2x2",
                "type": "string",
                "enum": [
                  "s",
                  "w",
                  "t",
                  "l"
                ]
              },
              "color": {
                "default": "auto",
                "description": "Tile background. \"auto\" picks a pastel from the theme",
                "type": "string",
                "enum": [
                  "auto",
                  "surface",
                  "accent",
                  "peach",
                  "butter",
                  "mint",
                  "sky",
                  "lilac",
                  "rose"
                ]
              },
              "type": {
                "type": "string",
                "const": "github"
              },
              "repo": {
                "type": "string",
                "pattern": "^[\\w.-]+\\/[\\w.-]+$",
                "description": "owner/name"
              },
              "description": {
                "description": "Filled automatically at build time",
                "type": "string"
              },
              "stars": {
                "description": "Filled automatically at build time",
                "type": "number"
              },
              "language": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "type",
              "repo"
            ]
          }
        ]
      }
    },
    "badge": {
      "default": true,
      "description": "Show a small \"Made with Posy\" link in the footer",
      "type": "boolean"
    }
  },
  "required": [
    "profile"
  ]
}
