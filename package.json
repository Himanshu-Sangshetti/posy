{
  "name": "posy",
  "version": "2.0.0",
  "private": true,
  "description": "A link-in-bio page that looks hand-made. Pick a look, add your links, publish. Edit it yourself or let your AI do it.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "posy": "tsx scripts/posy.ts",
    "check": "tsc --noEmit && tsx scripts/posy.ts validate examples/creator.json && tsx scripts/posy.ts validate examples/developer.json && tsx scripts/posy.ts validate examples/photographer.json",
    "schema": "tsx scripts/posy.ts schema",
    "docs:sync": "node scripts/docs-sync.mjs",
    "docs:dev": "npm run docs:sync && cd docs-site && npx mint@latest dev --port 3333",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.10",
    "@better-auth/cimd": "1.7.10",
    "@better-auth/core": "1.7.10",
    "@better-auth/mcp": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@vercel/blob": "^2.8.1",
    "better-auth": "1.7.10",
    "better-call": "1.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "jose": "6.1.3",
    "lucide-react": "^1.57.0",
    "marked": "18.1.1",
    "mcp-handler": "^2.3.0",
    "motion": "^14.2.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "simple-icons": "^16.35.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.170.0",
    "zod": "^4.6.7",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
